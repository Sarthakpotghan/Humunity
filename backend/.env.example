# Database — SQLite for local dev; switch to PostgreSQL for production
# e.g. postgresql+psycopg2://postgres:postgres@localhost:5432/humunity
DATABASE_URL=sqlite:///./humunity.db

# Auth (JWT)
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Email notifications (optional — leave empty to disable SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@humunity.org

# External services
NOMINATIM_USER_AGENT=Humunity/1.0
OSRM_BASE_URL=http://router.project-osrm.org

# Matching thresholds (km)
MAX_MATCH_DISTANCE_KM=25.0
DROPOFF_THRESHOLD_KM=5.0
VOLUNTEER_PICKUP_MAX_KM=25.0
